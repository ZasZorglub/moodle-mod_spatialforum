{{!
    @template mod_spatialforum/main
    One activity-wide conversation map. Native details remain usable without JavaScript.
}}
<div class="mod-spatialforum" data-region="spatialforum" data-cmid="{{cmid}}" data-context-id="{{contextid}}" data-sesskey="{{sesskey}}"
     data-loading-label="{{#str}}postloading, mod_spatialforum{{/str}}" data-loaded-label="{{#str}}postloaded, mod_spatialforum{{/str}}"
     data-load-error-label="{{#str}}postloadfailed, mod_spatialforum{{/str}}" data-retry-label="{{#str}}retry{{/str}}"
     data-fallback-label="{{#str}}reloadpost, mod_spatialforum{{/str}}"
     data-results-label="{{#str}}postsshown, mod_spatialforum{{/str}}"
     data-colours-enabled="{{enablecolors}}"
     data-read-url="{{readurl}}" data-read-label="{{#str}}readpost, mod_spatialforum{{/str}}"
     data-unread-label="{{#str}}unread, mod_spatialforum{{/str}}" data-root-label="{{#str}}maintrack, mod_spatialforum{{/str}}"
     data-whole-label="{{#str}}wholeconversation, mod_spatialforum{{/str}}"
     data-depth-label="{{#str}}replylevel, mod_spatialforum{{/str}}" data-initial-view="{{initialview}}"
     data-copied-label="{{#str}}linkcopied, mod_spatialforum{{/str}}"
     data-copy-failed-label="{{#str}}copyfailed, mod_spatialforum{{/str}}">
    <header class="spatialforum-hero">
        <div>
            <h2 class="sr-only">{{#str}}conversationmap, mod_spatialforum{{/str}}</h2>
            <p class="spatialforum-summary">{{postcount}} {{#str}}posts, mod_spatialforum{{/str}} ·
                <span data-region="unread-count">{{readcount}}</span> {{#str}}unreadposts, mod_spatialforum{{/str}}</p>
        </div>
        {{#canreply}}<a class="btn btn-primary" href="{{newposturl}}">{{#str}}newpost, mod_spatialforum{{/str}}</a>{{/canreply}}
    <div class="spatialforum-tools" data-region="tools" hidden>
        <div class="spatialforum-view-switch" role="group" aria-label="{{#str}}viewmode, mod_spatialforum{{/str}}">
            <button type="button" class="btn btn-outline-secondary" data-view="map" aria-pressed="false">{{#str}}mapview, mod_spatialforum{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" data-view="list" aria-pressed="false">{{#str}}listview, mod_spatialforum{{/str}}</button>
        </div>
        <button type="button" class="btn btn-outline-secondary spatialforum-density-toggle" data-density-toggle
                aria-pressed="false" title="{{#str}}compressedview_help, mod_spatialforum{{/str}}">
            {{#str}}compressedview, mod_spatialforum{{/str}}
        </button>
        <label class="spatialforum-search"><span class="sr-only">{{#str}}searchposts, mod_spatialforum{{/str}}</span>
            <input type="search" class="form-control" data-region="search" placeholder="{{#str}}searchposts, mod_spatialforum{{/str}}" aria-controls="spatialforum-posts-{{cmid}}">
        </label>
        <label class="spatialforum-unread-filter"><input type="checkbox" data-region="only-unread"> {{#str}}onlyunread, mod_spatialforum{{/str}}</label>
        <button type="button" class="btn btn-outline-secondary" data-next-unread>{{#str}}nextunread, mod_spatialforum{{/str}}</button>
    </div>
    </header>
    <p class="spatialforum-result-status" data-region="filter-status" role="status" hidden>{{#str}}filteredlist, mod_spatialforum{{/str}}</p>
    <p class="spatialforum-result-status" data-region="map-limit" hidden>{{#str}}maplimit, mod_spatialforum{{/str}}</p>
    <p class="spatialforum-result-status" data-region="no-results" role="status" hidden>{{#str}}noresults, mod_spatialforum{{/str}}</p>
    <p class="spatialforum-result-status" data-region="feedback" role="status"></p>
    {{#locked}}<div class="alert alert-warning" role="status">{{#str}}forumlocked, mod_spatialforum{{/str}}</div>{{/locked}}
    <nav class="spatialforum-route" data-region="route" aria-label="{{#str}}yourroute, mod_spatialforum{{/str}}">
        <span>{{#str}}wholeconversation, mod_spatialforum{{/str}}</span>
    </nav>
    <div class="alert alert-warning spatialforum-read-error" data-region="read-error" role="alert" hidden>
        {{#str}}readsavefailed, mod_spatialforum{{/str}}
    </div>
    <div class="spatialforum-viewport" data-region="viewport" tabindex="0" role="region"
         aria-label="{{#str}}conversationmap, mod_spatialforum{{/str}}">
    <section class="spatialforum-stage" data-region="stage" aria-label="{{#str}}conversationmap, mod_spatialforum{{/str}}">
        <svg class="spatialforum-connectors" data-region="connectors" aria-hidden="true" focusable="false"></svg>
        <div class="spatialforum-posts" id="spatialforum-posts-{{cmid}}">
            {{#posts}}
                <details class="spatialforum-post {{#unread}}is-unread{{/unread}}" id="post-{{id}}"
                         data-post-id="{{id}}" data-parent-id="{{parentid}}" data-colour="{{colour}}"
                         {{#deferred}}data-search-text="{{searchtext}}"{{/deferred}}
                         data-unread="{{#unread}}1{{/unread}}{{^unread}}0{{/unread}}"
                         data-readable="{{#cantrackread}}1{{/cantrackread}}{{^cantrackread}}0{{/cantrackread}}"
                         style="--post-colour: {{colour}};" {{#opened}}open{{/opened}}>
                    <summary class="spatialforum-card-toggle" aria-describedby="post-{{id}}-relationship">
                        <span class="spatialforum-subject">{{subject}}</span>
                        <span class="spatialforum-preview" aria-hidden="true">{{preview}}</span>
                        <span class="spatialforum-card-meta">
                            <span>{{author}}</span>
                            <span class="spatialforum-read-state" data-region="read-state">
                                {{#unread}}● {{#str}}unread, mod_spatialforum{{/str}}{{/unread}}
                                {{^unread}}{{#cantrackread}}✓ {{/cantrackread}}{{readlabel}}{{/unread}}
                            </span>
                        </span>
                        <span class="spatialforum-card-times">
                            <time datetime="{{creatediso}}">{{createdshort}}</time>
                            {{#edited}}<time datetime="{{editediso}}">{{editedshort}}</time>{{/edited}}
                        </span>
                    </summary>
                    <span class="sr-only" id="post-{{id}}-relationship">{{relationship}}</span>
                    <div class="spatialforum-post-detail" data-region="post-detail" {{#deferred}}data-deferred="1"{{/deferred}}>
                        {{#deferred}}
                            <p data-region="detail-status" role="status"></p>
                            <a href="{{fullposturl}}" data-load-detail>{{#str}}loadpost, mod_spatialforum{{/str}}</a>
                        {{/deferred}}
                        {{^deferred}}{{> mod_spatialforum/post_detail}}{{/deferred}}
                    </div>
                </details>
            {{/posts}}
        </div>
        {{^hasposts}}<p class="spatialforum-empty">{{#str}}noposts, mod_spatialforum{{/str}}</p>{{/hasposts}}
    </section>
    </div>
    {{#subscriptionurl}}<p class="spatialforum-subscription"><a href="{{subscriptionurl}}">{{#str}}notificationpreferences, mod_spatialforum{{/str}}</a></p>{{/subscriptionurl}}
    {{#exporturl}}<p class="spatialforum-export"><a href="{{exporturl}}">{{#str}}exportforum, mod_spatialforum{{/str}}</a></p>{{/exporturl}}
    {{#assessmenturl}}<p><a href="{{assessmenturl}}">{{assessmentlabel}}</a></p>{{/assessmenturl}}
    <footer class="spatialforum-legend">
        <span><i class="spatialforum-root-dot" aria-hidden="true"></i>{{#str}}maintrack, mod_spatialforum{{/str}}</span>
        <span><i class="spatialforum-route-dot" aria-hidden="true"></i>{{#str}}yourroute, mod_spatialforum{{/str}}</span>
        <span>● {{#str}}unread, mod_spatialforum{{/str}}</span>
        <span>✓ {{#str}}readpost, mod_spatialforum{{/str}}</span>
    </footer>
</div>
