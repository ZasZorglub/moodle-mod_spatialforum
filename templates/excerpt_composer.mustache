{{!
    @template mod_spatialforum/excerpt_composer
    Selected source passages and the reply author's interleaved comments.
}}
<details class="spatialforum-excerpt-composer" data-excerpt-composer {{#excerptmode}}open{{/excerptmode}}
         data-comment-label="{{#str}}excerptcomment, mod_spatialforum{{/str}}"
         data-remove-label="{{#str}}removeexcerpt, mod_spatialforum{{/str}}"
         data-limit-label="{{#str}}excerptlimit, mod_spatialforum{{/str}}"
         data-removed-label="{{#str}}excerptremoved, mod_spatialforum{{/str}}"
         data-message-label="{{#str}}message, mod_spatialforum{{/str}}"
         data-closing-label="{{#str}}closingcomment, mod_spatialforum{{/str}}">
    <summary data-excerpt-heading>{{#str}}excerptreply, mod_spatialforum{{/str}}</summary>
    <p>{{#str}}excerptinstructions, mod_spatialforum{{/str}}</p>
    <button type="button" class="btn btn-outline-secondary" data-add-excerpt disabled>
        {{#str}}addexcerpt, mod_spatialforum{{/str}}
    </button>
    <div data-excerpt-parts></div>
    <p data-excerpt-status role="status"></p>
    <noscript><p>{{#str}}excerptrequiresjs, mod_spatialforum{{/str}}</p></noscript>
</details>
